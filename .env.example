# Copy to .env.local for local builds. PUBLIC values only — they are embedded in the
# browser bundle, so never put secrets here.

# HTTPS URL of the FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Origin of this website, without a path (used for canonical links and the sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only when hosting under a sub-path, e.g. https://gunwatts.github.io/Homemadefood-Ayudhas-Frontend/
#   NEXT_PUBLIC_BASE_PATH=/Homemadefood-Ayudhas-Frontend
NEXT_PUBLIC_BASE_PATH=
